---
---
<section id="showcase" class="relative pt-8 pb-16 lg:py-24 px-4 sm:px-6 lg:px-12 max-w-7xl mx-auto flex flex-col lg:flex-row items-center gap-12 lg:gap-16 scroll-mt-24">
  
  <!-- Left Side: Copy and Interactive Buttons -->
  <div class="flex-1 text-center lg:text-left z-10">
    <!-- Badge -->
    <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-brand-soft-pink border border-brand-peach/25 text-brand-peach text-sm font-bold mb-6 hover:scale-105 transition-transform duration-300">
      <span class="flex h-2 w-2 rounded-full bg-brand-peach animate-ping"></span>
      <span>¡Ya disponible la versión v1.2.0!</span>
    </div>

    <!-- Main Title -->
    <h1 class="font-display font-bold text-4xl sm:text-5xl lg:text-6xl text-stone-800 leading-tight mb-6">
      Brilla con tu propia luz, <br/>
      <span class="bg-gradient-to-r from-brand-peach to-brand-rose bg-clip-text text-transparent relative">
        todos los días
        <!-- Underline decoration -->
        <svg class="absolute left-0 bottom-[-8px] w-full h-3 text-brand-rose/40" viewBox="0 0 100 10" preserveAspectRatio="none">
          <path d="M0,5 Q50,10 100,5" stroke="currentColor" stroke-width="4" fill="none" stroke-linecap="round"/>
        </svg>
      </span>
    </h1>

    <!-- Description -->
    <p class="text-stone-600 text-base sm:text-lg md:text-xl font-medium leading-relaxed max-w-xl mx-auto lg:mx-0 mb-8">
      Luna y Brillo es tu compañera de autocuidado en Flutter. Monitorea tu ciclo menstrual, organiza tu cronograma capilar y descubre rutinas de skincare creadas a tu medida. ¡Todo en un diseño hermoso y tierno!
    </p>

    <!-- CTAs -->
    <div class="flex flex-col sm:flex-row justify-center lg:justify-start gap-4 mb-10">
      <a 
        href="#download" 
        class="bg-brand-peach hover:bg-brand-peach-hover text-white px-8 py-4 rounded-3xl font-bold shadow-md hover:shadow-lg transition-all duration-300 hover:-translate-y-1 text-lg flex items-center justify-center gap-2 group"
      >
        <span>Descargar APK gratis</span>
        <svg class="w-5 h-5 group-hover:translate-y-0.5 transition-transform" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3"/>
        </svg>
      </a>
      <a 
        href="#features" 
        class="bg-white hover:bg-stone-50 border-2 border-brand-soft-pink text-stone-700 px-8 py-4 rounded-3xl font-bold transition-all duration-300 hover:-translate-y-1 text-lg flex items-center justify-center"
      >
        Ver Características
      </a>
    </div>

    <!-- Interactive Section Tabs (Controls Mockup) -->
    <div class="bg-white/60 backdrop-blur-xs border border-brand-soft-pink/60 p-4 rounded-3xl shadow-xs max-w-md mx-auto lg:mx-0">
      <p class="text-xs text-stone-500 font-bold uppercase tracking-wider text-center lg:text-left mb-3">
        Explora la app en tiempo real:
      </p>
      <div class="grid grid-cols-3 gap-2">
        <button 
          id="btn-ciclo" 
          class="tab-btn active bg-brand-peach text-white py-3 px-2 rounded-2xl font-bold text-xs sm:text-sm shadow-xs transition-all duration-300 hover:scale-102 flex flex-col items-center gap-1.5"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z"/>
          </svg>
          <span>Ver Ciclo</span>
        </button>

        <button 
          id="btn-cabello" 
          class="tab-btn bg-white hover:bg-brand-soft-pink/50 text-stone-700 py-3 px-2 rounded-2xl font-bold text-xs sm:text-sm border border-brand-soft-pink transition-all duration-300 hover:scale-102 flex flex-col items-center gap-1.5"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.53 16.122A3 3 0 0 0 10.5 21.5h3a3 3 0 0 0 .97-5.378m-4.44-1.122L10.5 21.5m4.44-6.5L13.5 21.5M7.5 6L21 14m-16.5-6L18 16" />
          </svg>
          <span>Ver Cabello</span>
        </button>

        <button 
          id="btn-piel" 
          class="tab-btn bg-white hover:bg-brand-soft-pink/50 text-stone-700 py-3 px-2 rounded-2xl font-bold text-xs sm:text-sm border border-brand-soft-pink transition-all duration-300 hover:scale-102 flex flex-col items-center gap-1.5"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z"/>
          </svg>
          <span>Ver Piel</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Right Side: Floating Smartphone Mockup -->
  <div class="flex-1 flex justify-center items-center relative py-8 w-full">
    <!-- Star particles behind phone -->
    <div class="absolute -top-4 -left-4 w-8 h-8 text-brand-peach opacity-30 animate-pulse-slow">
      <svg fill="currentColor" viewBox="0 0 24 24"><path d="M12 0L14.6 9.4L24 12L14.6 14.6L12 24L9.4 14.6L0 12L9.4 9.4L12 0Z"/></svg>
    </div>
    <div class="absolute bottom-8 right-0 w-12 h-12 text-brand-rose opacity-40 animate-float" style="animation-duration: 5s;">
      <svg fill="currentColor" viewBox="0 0 24 24"><path d="M12 0L14.6 9.4L24 12L14.6 14.6L12 24L9.4 14.6L0 12L9.4 9.4L12 0Z"/></svg>
    </div>
    <div class="absolute top-[60%] -left-10 w-6 h-6 text-brand-coral opacity-50 animate-float" style="animation-duration: 7s;">
      <svg fill="currentColor" viewBox="0 0 24 24"><path d="M12 0L14.6 9.4L24 12L14.6 14.6L12 24L9.4 14.6L0 12L9.4 9.4L12 0Z"/></svg>
    </div>

    <!-- Phone Wrapper with Floating Animation -->
    <div class="relative w-[300px] sm:w-[330px] h-[600px] sm:h-[660px] bg-stone-900 rounded-[50px] border-[10px] border-stone-800 shadow-2xl animate-float overflow-hidden flex flex-col">
      <!-- Top Speaker / Camera Notch -->
      <div class="absolute top-2 left-1/2 -translate-x-1/2 w-32 h-6 bg-stone-900 rounded-b-2xl z-30 flex items-center justify-center">
        <!-- Camera hole -->
        <div class="w-3 h-3 bg-stone-800 rounded-full border border-stone-700/50"></div>
      </div>

      <!-- Smartphone Internal Screen Screen -->
      <div class="relative flex-1 bg-brand-cream/90 flex flex-col justify-between overflow-hidden">
        
        <!-- Status Bar -->
        <div class="pt-9 px-6 flex justify-between items-center text-[10px] font-bold text-stone-600 z-20">
          <span>12:45 🌙</span>
          <div class="flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 3c-4.97 0-9 4.03-9 9 0 2.12.74 4.07 1.97 5.61L4.35 19.4c-.39.39-.39 1.02 0 1.41.39.39 1.02.39 1.41 0l1.9-1.9C9.07 19.58 10.48 20 12 20c4.97 0 9-4.03 9-9s-4.03-9-9-9zm0 15c-3.31 0-6-2.69-6-6s2.69-6 6-6 6 2.69 6 6-2.69 6-6 6z"/>
            </svg>
            <span>98%</span>
          </div>
        </div>

        <!-- Phone Header / App Bar -->
        <div class="px-5 py-3 border-b border-brand-soft-pink flex items-center justify-between z-10 bg-white/60 backdrop-blur-xs">
          <div class="flex items-center gap-2">
            <img src="/images/app-logo.png" alt="Luna y Brillo Logo" class="w-8 h-8 object-contain rounded-lg shadow-3xs bg-white/40 p-0.5 border border-brand-peach/10" />
            <div>
              <h3 class="font-display font-bold text-stone-800 text-sm leading-tight">Luna y Brillo</h3>
              <p class="text-[9px] text-stone-500 font-semibold tracking-wider">MI DIARIO DE BIENESTAR</p>
            </div>
          </div>
          <button class="w-8 h-8 rounded-xl bg-brand-soft-pink/50 flex items-center justify-center text-brand-peach hover:bg-brand-soft-pink transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 0 0 5.454-1.31A8.967 8.967 0 0 1 18 9.75V9A6 6 0 0 0 6 9v.75a8.967 8.967 0 0 1-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a3 3 0 1 1-5.714 0M3.124 7.5A8.969 8.969 0 0 1 5.292 3m13.416 0a8.969 8.969 0 0 1 2.168 4.5" />
            </svg>
          </button>
        </div>

        <!-- Main Screen Content -->
        <div class="flex-1 p-4 overflow-y-auto z-10 flex flex-col bg-stone-50/10">
          
          <!-- 0. INICIO DASHBOARD SCREEN (Active by default) -->
          <div id="screen-content-inicio" class="screen-view opacity-100 transition-all duration-300 flex-1 flex flex-col justify-between space-y-4">
            <div class="space-y-4">
              <!-- Welcome Header inside mockup -->
              <div class="flex items-center justify-between">
                <div>
                  <h4 id="mockup-greeting" class="font-display font-extrabold text-stone-800 text-sm leading-tight">¡Buenas noches, Camila! 🌙</h4>
                  <p class="text-[9px] text-stone-400 font-bold">domingo 17 de mayo</p>
                </div>
                <img src="/images/app-logo.png" class="w-8 h-8 rounded-full border border-brand-peach/20" />
              </div>

              <!-- Card 1: Próximo Ciclo (Coral) -->
              <div class="bg-gradient-to-r from-[#E88A76] to-[#EC9F8D] p-3.5 rounded-2xl shadow-xs text-white flex items-center gap-4 border border-white/10">
                <!-- Circular Progress -->
                <div class="relative w-12 h-12 flex-shrink-0 flex items-center justify-center bg-white/20 rounded-full border border-white/20">
                  <div class="absolute inset-1 rounded-full border-2 border-transparent border-t-white animate-pulse" style="transform: rotate(270deg);"></div>
                  <div class="text-center leading-none">
                    <span class="block text-xs font-extrabold">18</span>
                    <span class="text-[7px] font-bold opacity-80">días</span>
                  </div>
                </div>
                <!-- Card Details -->
                <div class="leading-tight">
                  <div class="flex items-center gap-1">
                    <span>🌙</span>
                    <span class="text-[11px] font-bold">Próximo Ciclo</span>
                  </div>
                  <p class="text-[9px] text-white/95 mt-1 font-semibold">Tu próximo ciclo será en 18 días</p>
                  <p class="text-[8px] text-white/70 mt-0.5">viernes 5 de junio</p>
                </div>
              </div>

              <!-- Card 2: Arreglo Capilar (Pastel Brown) -->
              <div class="bg-[#BFA38A] p-3.5 rounded-2xl shadow-xs text-white flex items-center gap-4 border border-white/10">
                <!-- Circular Progress -->
                <div class="relative w-12 h-12 flex-shrink-0 flex items-center justify-center bg-white/20 rounded-full border border-white/20">
                  <div class="absolute inset-1 rounded-full border-2 border-transparent border-t-white" style="transform: rotate(90deg);"></div>
                  <div class="text-center leading-none">
                    <span class="block text-xs font-extrabold">3</span>
                    <span class="text-[7px] font-bold opacity-80">días</span>
                  </div>
                </div>
                <!-- Card Details -->
                <div class="leading-tight">
                  <div class="flex items-center gap-1">
                    <span>✨</span>
                    <span class="text-[11px] font-bold">Arreglo Capilar</span>
                  </div>
                  <p class="text-[9px] text-white/95 mt-1 font-semibold">Tu próximo arreglo capilar podría ser en 3 días</p>
                  <p class="text-[8px] text-white/70 mt-0.5">Cabello mixto • miércoles 20 may</p>
                </div>
              </div>

              <!-- Card 3: Fase Folicular (White Card) -->
              <div class="bg-white p-3.5 rounded-2xl border border-brand-soft-pink/50 shadow-3xs flex flex-col gap-2">
                <div class="flex justify-between items-center">
                  <div class="flex items-center gap-1.5">
                    <span class="text-emerald-500 text-sm">🌱</span>
                    <div class="leading-none">
                      <span class="text-xs font-extrabold text-stone-800">Fase Folicular</span>
                      <span class="block text-[8px] text-stone-400">Día 6 de 24</span>
                    </div>
                  </div>
                  <span class="text-[8px] bg-emerald-50 text-emerald-600 font-extrabold px-1.5 py-0.5 rounded-md border border-emerald-100/50">Regular</span>
                </div>
                <p class="text-[9.5px] text-stone-600 font-semibold leading-normal">
                  Tu energía crece. ¡Momento ideal para nuevos proyectos!
                </p>
                <div class="w-full h-1 bg-stone-100 rounded-full overflow-hidden mt-0.5">
                  <div class="h-full bg-[#E88A76] rounded-full" style="width: 25%;"></div>
                </div>
              </div>

              <!-- Card 4: Resumen -->
              <div class="bg-white p-3.5 rounded-2xl border border-brand-soft-pink/50 shadow-3xs">
                <h5 class="text-xs font-extrabold text-stone-800 mb-2.5 flex items-center gap-1">
                  <span>📊</span> Resumen
                </h5>
                <div class="grid grid-cols-4 gap-1.5">
                  <!-- Item 1 -->
                  <div class="bg-rose-50/40 p-2 rounded-xl text-center flex flex-col items-center justify-between border border-rose-100/20">
                    <span class="text-[11px] text-rose-400">❤️</span>
                    <span class="text-[9px] font-extrabold text-stone-800 mt-1">24d</span>
                    <span class="text-[7px] text-stone-400 font-extrabold block leading-tight mt-0.5">Ciclo prom.</span>
                  </div>
                  <!-- Item 2 -->
                  <div class="bg-amber-50/40 p-2 rounded-xl text-center flex flex-col items-center justify-between border border-amber-100/20">
                    <span class="text-[11px] text-amber-500">💧</span>
                    <span class="text-[9px] font-extrabold text-stone-800 mt-1">Día 10</span>
                    <span class="text-[7px] text-stone-400 font-extrabold block leading-tight mt-0.5">Ovulación</span>
                  </div>
                  <!-- Item 3 -->
                  <div class="bg-cyan-50/40 p-2 rounded-xl text-center flex flex-col items-center justify-between border border-cyan-100/20">
                    <span class="text-[11px] text-cyan-500">💧</span>
                    <span class="text-[9px] font-extrabold text-stone-800 mt-1">13</span>
                    <span class="text-[7px] text-stone-400 font-extrabold block leading-tight mt-0.5">Lavados</span>
                  </div>
                  <!-- Item 4 -->
                  <div class="bg-indigo-50/40 p-2 rounded-xl text-center flex flex-col items-center justify-between border border-indigo-100/20">
                    <span class="text-[11px] text-indigo-400">📅</span>
                    <span class="text-[9px] font-extrabold text-stone-800 mt-1">6</span>
                    <span class="text-[7px] text-stone-400 font-extrabold block leading-tight mt-0.5">Registros</span>
                  </div>
                </div>
              </div>
            </div>
            <p class="text-center text-[9px] text-stone-400 font-bold uppercase tracking-widest mt-2">🏠 Panel de Inicio</p>
          </div>
          
          <!-- 1. MONITOREO DEL CICLO SCREEN (Hidden by default) -->
          <div id="screen-content-ciclo" class="screen-view hidden opacity-0 transition-all duration-300 flex-1 flex flex-col justify-between space-y-4">
            <div class="space-y-4">
              <!-- Header centered -->
              <h4 class="text-center font-display font-extrabold text-stone-850 text-sm leading-tight mt-1 flex items-center justify-center gap-1">Mi Ciclo 🌙</h4>
              
              <!-- Coral/Peach Card -->
              <div class="bg-gradient-to-r from-[#E88A76] to-[#EE9C89] p-3 rounded-2xl shadow-3xs text-white flex items-center justify-between border border-white/10">
                <div class="leading-tight">
                  <div class="flex items-center gap-1.5">
                    <span class="text-xs">📅</span>
                    <span class="text-[10px] font-extrabold">Próximo periodo estimado</span>
                  </div>
                  <p class="text-[9.5px] text-white/90 mt-1 font-semibold">En 18 días · 5 jun</p>
                </div>
                <div class="bg-white/20 px-2.5 py-1.5 rounded-xl text-center border border-white/15 leading-none">
                  <span class="block text-[11px] font-extrabold">18</span>
                  <span class="text-[7px] font-bold opacity-80">días</span>
                </div>
              </div>

              <!-- High fidelity Calendar Grid -->
              <div class="bg-white p-3 rounded-2xl border border-brand-soft-pink/50 shadow-3xs space-y-2">
                <div class="flex justify-between items-center text-[10px] font-extrabold text-stone-750 px-1">
                  <span class="text-[#E88A76] cursor-pointer hover:scale-110 transition-transform">&lt;</span>
                  <span>May 2026</span>
                  <span class="text-[#E88A76] cursor-pointer hover:scale-110 transition-transform">&gt;</span>
                </div>
                <div class="grid grid-cols-7 text-center text-[8px] font-bold text-stone-400 border-b border-stone-50 pb-1">
                  <span>Sun</span><span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span>
                </div>
                <div class="grid grid-cols-7 gap-y-2 text-center text-[10px] font-extrabold text-stone-700">
                  <!-- Row 1 -->
                  <span></span><span></span><span></span><span></span><span></span>
                  <span class="relative py-1 flex items-center justify-center">1</span>
                  <span class="relative py-1 flex items-center justify-center">2</span>
                  
                  <!-- Row 2 -->
                  <span class="relative py-1 flex items-center justify-center">3</span>
                  <span class="relative py-1 flex items-center justify-center">4</span>
                  <span class="relative py-1 flex items-center justify-center">5</span>
                  <span class="relative py-1 flex items-center justify-center">6</span>
                  <span class="relative py-1 flex items-center justify-center">7</span>
                  <span class="relative py-1 flex items-center justify-center">8</span>
                  <span class="relative py-1 flex items-center justify-center">9</span>
                  
                  <!-- Row 3 -->
                  <span class="relative py-1 flex items-center justify-center">10</span>
                  <span class="relative py-1 flex items-center justify-center">11</span>
                  <!-- Period Days with Red Dots -->
                  <span class="relative py-1 flex flex-col items-center justify-center">12<span class="w-1 h-1 bg-red-400 rounded-full absolute bottom-0.5"></span></span>
                  <span class="relative py-1 flex flex-col items-center justify-center">13<span class="w-1 h-1 bg-red-400 rounded-full absolute bottom-0.5"></span></span>
                  <span class="relative py-1 flex flex-col items-center justify-center">14<span class="w-1 h-1 bg-red-400 rounded-full absolute bottom-0.5"></span></span>
                  <span class="relative py-1 flex flex-col items-center justify-center">15<span class="w-1 h-1 bg-red-400 rounded-full absolute bottom-0.5"></span></span>
                  <span class="relative py-1 flex flex-col items-center justify-center">16<span class="w-1 h-1 bg-red-400 rounded-full absolute bottom-0.5"></span></span>
                  
                  <!-- Selected Current Day (17) Circled exactly like Flutter app screen -->
                  <span class="relative py-1 flex items-center justify-center bg-[#FCE2DB] text-[#E88A76] rounded-full w-5 h-5 mx-auto leading-none border border-[#E88A76]/20">17</span>
                  
                  <span class="relative py-1 flex items-center justify-center">18</span>
                  <span class="relative py-1 flex items-center justify-center">19</span>
                  <span class="relative py-1 flex items-center justify-center">20</span>
                  <span class="relative py-1 flex items-center justify-center">21</span>
                  <span class="relative py-1 flex items-center justify-center">22</span>
                  <span class="relative py-1 flex items-center justify-center">23</span>
                  
                  <!-- Row 5 -->
                  <span class="relative py-1 flex items-center justify-center">24</span>
                  <span class="relative py-1 flex items-center justify-center">25</span>
                  <span class="relative py-1 flex items-center justify-center">26</span>
                  <span class="relative py-1 flex items-center justify-center">27</span>
                  <span class="relative py-1 flex items-center justify-center">28</span>
                  <span class="relative py-1 flex items-center justify-center">29</span>
                  <span class="relative py-1 flex items-center justify-center">30</span>
                  
                  <!-- Row 6 -->
                  <span class="relative py-1 flex items-center justify-center">31</span>
                </div>
              </div>
            </div>

            <!-- Floating Action Button at the bottom -->
            <button class="bg-[#E88A76] hover:bg-[#D67A66] text-white py-2 px-5 rounded-xl font-bold shadow-xs hover:shadow-xs transition-all duration-300 hover:scale-102 flex items-center justify-center gap-1.5 text-[10.5px] w-full max-w-[140px] mx-auto mb-1 mt-auto">
              <span class="text-xs">➕</span> Registrar
            </button>
            
            <p class="text-center text-[9px] text-stone-400 font-bold uppercase tracking-widest mt-2">🌸 Monitoreo del Ciclo</p>
          </div>

          <!-- 2. CRONOGRAMA CAPILAR SCREEN (Hidden) -->
          <div id="screen-content-cabello" class="screen-view hidden opacity-0 transition-all duration-300 flex-1 flex flex-col justify-between space-y-4">
            <div class="space-y-3">
              <!-- Header centered -->
              <h4 class="text-center font-display font-extrabold text-stone-850 text-sm leading-tight mt-1">Rutina Capilar ✨</h4>
              
              <!-- Card: Próximo lavado en 3 días (Soft Peach Yellow Background) -->
              <div class="bg-[#FCEFD9]/80 p-2.5 rounded-2xl shadow-3xs border border-amber-100/50 flex items-center gap-3">
                <!-- Avatar Girl Short hair -->
                <div class="w-9 h-9 bg-gradient-to-br from-amber-200 to-amber-300 rounded-xl flex items-center justify-center text-base shadow-3xs flex-shrink-0">
                  👩
                </div>
                <div class="leading-tight">
                  <span class="block text-[9px] text-stone-500 font-bold">Cabello mixto</span>
                  <span class="block text-[11px] font-extrabold text-stone-800 mt-0.5">Próximo lavado en 3 días</span>
                  <span class="block text-[8px] text-stone-400 font-bold mt-0.5">miércoles 20 may</span>
                </div>
              </div>

              <!-- Treatment Legend Row -->
              <div class="flex flex-wrap justify-center gap-x-2 gap-y-1 py-1 text-[7.5px] font-extrabold text-stone-500 bg-white/40 p-2 rounded-xl border border-brand-soft-pink/30">
                <span class="flex items-center gap-0.5"><span class="w-1.5 h-1.5 rounded-full bg-[#E88A76]"></span>Lavado</span>
