    const tabs = [
      {
        id: 'inicio',
        btn: document.getElementById('btn-tab-inicio'),
        navBtn: document.getElementById('phone-nav-inicio'),
        screen: document.getElementById('mockup-screen-inicio')
      },
      {
        id: 'ciclo',
        btn: document.getElementById('btn-tab-ciclo'),
        navBtn: document.getElementById('phone-nav-ciclo'),
        screen: document.getElementById('mockup-screen-ciclo')
      },
      {
        id: 'cabello',
        btn: document.getElementById('btn-tab-cabello'),
        navBtn: document.getElementById('phone-nav-cabello'),
        screen: document.getElementById('mockup-screen-cabello')
      },
      {
        id: 'piel',
        btn: document.getElementById('btn-tab-piel'),
        navBtn: document.getElementById('phone-nav-piel'),
        screen: document.getElementById('mockup-screen-piel')
      },
      {
        id: 'perfil',
        btn: document.getElementById('btn-tab-perfil'),
        navBtn: document.getElementById('phone-nav-perfil'),
        screen: document.getElementById('mockup-screen-perfil')
      },
      {
        id: 'ajustes',
        btn: document.getElementById('btn-tab-ajustes-outside'),
        navBtn: null,
        screen: document.getElementById('mockup-screen-ajustes')
      },
      {
        id: 'pareja',
        btn: document.getElementById('btn-tab-pareja'),
        navBtn: null,
        screen: document.getElementById('mockup-screen-pareja')
      }
    ];

    function activateTab(tabId) {
      tabs.forEach(t => {
        if (t.id === tabId) {
          // Outside button active state
          t.btn?.classList.remove('bg-white', 'text-[#7A5C68]', 'border', 'border-[#DF7591]/30');
          t.btn?.classList.add('bg-[#70163C]', 'text-white', 'shadow-xs', 'active');
          
          // Inside phone nav button active state
          t.navBtn?.classList.remove('text-[#A795A0]');
          t.navBtn?.classList.add('text-[#DF7591]', 'active');

          // Screen visibility
          if (t.screen) {
            t.screen.classList.remove('hidden');
            setTimeout(() => {
              t.screen.classList.add('opacity-100');
              t.screen.classList.remove('opacity-0');
            }, 10);
          }
        } else {
          // Outside button inactive state
          t.btn?.classList.remove('bg-[#70163C]', 'text-white', 'shadow-xs', 'active');
          t.btn?.classList.add('bg-white', 'text-[#7A5C68]', 'border', 'border-[#DF7591]/30');
          
          // Inside phone nav button inactive state
          t.navBtn?.classList.remove('text-[#DF7591]', 'active');
          t.navBtn?.classList.add('text-[#A795A0]');

          // Screen visibility
          if (t.screen) {
            t.screen.classList.remove('opacity-100');
            t.screen.classList.add('opacity-0');
            t.screen.classList.add('hidden');
          }
        }
      });
    }

    tabs.forEach(t => {
      t.btn?.addEventListener('click', () => activateTab(t.id));
      t.navBtn?.addEventListener('click', () => activateTab(t.id));
    });

    // Peeking button in Inicio transitions to Ciclo
    document.getElementById('peek-ciclo-btn')?.addEventListener('click', () => {
      activateTab('ciclo');
    });

    // Toast helper inside mockup
    const phoneToast = document.getElementById('phone-toast');
    function showPhoneToast(msg) {
      if (!phoneToast) return;
      phoneToast.textContent = msg;
      phoneToast.classList.remove('translate-y-10', 'opacity-0');
      phoneToast.classList.add('translate-y-0', 'opacity-100');
      setTimeout(() => {
        phoneToast.classList.remove('translate-y-0', 'opacity-100');
        phoneToast.classList.add('translate-y-10', 'opacity-0');
      }, 2500);
    }

    // Toggle Modo Pareja Heart in Mi Ciclo
    let partnerEnabled = true;
    const heartBtn = document.getElementById('phone-ciclo-heart-btn');
    const toggleHeartBtn = document.getElementById('toggle-partner-heart-mode');
    const toggleHeartIcon = document.getElementById('partner-toggle-icon');
    const toggleHeartText = document.getElementById('partner-toggle-text');

    function updatePartnerHeartUI(showNotification = true) {
      if (partnerEnabled) {
        heartBtn?.classList.remove('hidden');
        if (toggleHeartIcon) toggleHeartIcon.textContent = '💖';
        if (toggleHeartText) toggleHeartText.textContent = 'Habilitado';
        toggleHeartBtn?.classList.remove('bg-stone-100', 'text-stone-500');
        toggleHeartBtn?.classList.add('bg-[#FCE8EE]', 'text-[#70163C]');
        if (showNotification) showPhoneToast('Modo Pareja Habilitado en Mi Ciclo 💕');
      } else {
        heartBtn?.classList.add('hidden');
        if (toggleHeartIcon) toggleHeartIcon.textContent = '🤍';
        if (toggleHeartText) toggleHeartText.textContent = 'Deshabilitado';
        toggleHeartBtn?.classList.remove('bg-[#FCE8EE]', 'text-[#70163C]');
        toggleHeartBtn?.classList.add('bg-stone-100', 'text-stone-500');
        if (showNotification) showPhoneToast('Modo Pareja Oculto 🤍');
      }
    }

    toggleHeartBtn?.addEventListener('click', () => {
      partnerEnabled = !partnerEnabled;
      updatePartnerHeartUI(true);
    });

    // Clicking heart inside the phone triggers Modo Pareja view
    heartBtn?.addEventListener('click', () => {
      showPhoneToast('Abriendo Modo Pareja sincronizado... 💕');
      setTimeout(() => {
        activateTab('pareja');
      }, 600);
    });

    // PDF Report Generator button
    const pdfBtn = document.getElementById('phone-ciclo-pdf-btn');
    const pdfBtnOutside = document.getElementById('btn-trigger-pdf-outside');

    function triggerPdfAction() {
      showPhoneToast('📄 Generando Reporte Médico en PDF para ginecología...');
      setTimeout(() => {
        alert('📄 Reporte Médico Ginecológico y de Salud generado con éxito en PDF. Incluye regularidad del ciclo, duración media, fases y notas para tu médico.');
      }, 400);
    }

    pdfBtn?.addEventListener('click', triggerPdfAction);
    pdfBtnOutside?.addEventListener('click', () => {
      activateTab('ciclo');
      triggerPdfAction();
    });

    // Registrar button inside Mi Ciclo
    document.getElementById('phone-btn-registrar')?.addEventListener('click', () => {
      showPhoneToast('✨ Registro de síntomas y notas del ciclo abierto.');
    });

    // Hair registrar button
    document.getElementById('phone-btn-registrar-cabello')?.addEventListener('click', () => {
      showPhoneToast('✨ Registro de lavado, corte o tratamiento capilar abierto.');
    });

    // Plan Capilar Desplegable / Expandable Accordion
    const planCard = document.getElementById('phone-plan-capilar-card');
    const planHeader = document.getElementById('plan-capilar-header');
    const planBody = document.getElementById('plan-capilar-body');
    const planChevron = document.getElementById('plan-capilar-chevron');
    let planExpanded = false;

    planHeader?.addEventListener('click', (e) => {
      e.stopPropagation();
      planExpanded = !planExpanded;
      if (planExpanded) {
        planBody?.classList.remove('hidden');
        if (planChevron) planChevron.textContent = '▲';
        showPhoneToast('Plan Capilar Desplegado 💡✨');
      } else {
        planBody?.classList.add('hidden');
        if (planChevron) planChevron.textContent = '▼';
      }
    });

    // Plan Capilar Pills: Crecimiento y Fuerza vs Salud y Brillo
    const pillFuerza = document.getElementById('pill-plan-fuerza');
    const pillBrillo = document.getElementById('pill-plan-brillo');
    const planTitle = document.getElementById('plan-current-title');
    const treatmentsList = document.getElementById('plan-treatments-list');
    const ingredientsWrap = document.getElementById('plan-ingredients-wrap');
    const footerNote = document.getElementById('plan-footer-note');

    pillFuerza?.addEventListener('click', (e) => {
      e.stopPropagation();
      pillFuerza.className = 'bg-white text-[#2D141E] font-extrabold px-2.5 py-1 rounded-full shadow-xs flex items-center gap-1 flex-shrink-0';
      if (pillBrillo) pillBrillo.className = 'bg-black/30 border border-white/20 text-white font-semibold px-2.5 py-1 rounded-full flex-shrink-0';
      if (planTitle) planTitle.textContent = 'Crecimiento y Fuerza';
      if (treatmentsList) {
        treatmentsList.innerHTML = `
          <li class="flex items-start gap-1"><span>•</span><span>Aceite de ricino solo en cuero cabelludo</span></li>
          <li class="flex items-start gap-1"><span>•</span><span>Mascarilla nutritiva de medios a puntas</span></li>
        `;
      }
      if (ingredientsWrap) {
        ingredientsWrap.innerHTML = `
          <span class="bg-white/15 px-2 py-0.5 rounded-md text-[7.5px] text-white font-semibold">Aceite de ricino</span>
          <span class="bg-white/15 px-2 py-0.5 rounded-md text-[7.5px] text-white font-semibold">Keratina</span>
          <span class="bg-white/15 px-2 py-0.5 rounded-md text-[7.5px] text-white font-semibold">Aloe vera</span>
        `;
      }
      if (footerNote) {
        footerNote.innerHTML = `<span>✨</span><span>Equilibra la limpieza de la raíz con la hidratación de las puntas</span>`;
      }
      showPhoneToast('Plan: Crecimiento y Fuerza activado 🌿');
    });

    pillBrillo?.addEventListener('click', (e) => {
      e.stopPropagation();
      pillBrillo.className = 'bg-white text-[#2D141E] font-extrabold px-2.5 py-1 rounded-full shadow-xs flex items-center gap-1 flex-shrink-0';
      if (pillFuerza) pillFuerza.className = 'bg-black/30 border border-white/20 text-white font-semibold px-2.5 py-1 rounded-full flex-shrink-0';
      if (planTitle) planTitle.textContent = 'Salud y Brillo';
      if (treatmentsList) {
        treatmentsList.innerHTML = `
          <li class="flex items-start gap-1"><span>•</span><span>Enjuague de vinagre de manzana diluido</span></li>
          <li class="flex items-start gap-1"><span>•</span><span>Mascarilla de brillo intenso con miel y argán</span></li>
        `;
      }
      if (ingredientsWrap) {
        ingredientsWrap.innerHTML = `
          <span class="bg-white/15 px-2 py-0.5 rounded-md text-[7.5px] text-white font-semibold">Aceite de argán</span>
          <span class="bg-white/15 px-2 py-0.5 rounded-md text-[7.5px] text-white font-semibold">Pantenol</span>
          <span class="bg-white/15 px-2 py-0.5 rounded-md text-[7.5px] text-white font-semibold">Miel pura</span>
        `;
      }
      if (footerNote) {
        footerNote.innerHTML = `<span>✨</span><span>Sella la cutícula capilar para reflejar máxima luz</span>`;
      }
      showPhoneToast('Plan: Salud y Brillo activado ✨');
    });

    // Facial Routine Tabs: Mañana vs Noche
    const btnFacialDay = document.getElementById('btn-facial-day');
    const btnFacialNight = document.getElementById('btn-facial-night');
    const stepsDay = document.getElementById('facial-steps-day');
    const stepsNight = document.getElementById('facial-steps-night');

    btnFacialDay?.addEventListener('click', () => {
      btnFacialDay.className = 'flex-1 py-1.5 rounded-xl bg-[#2D1B32] border border-white/15 text-white flex items-center justify-center gap-1.5 shadow-xs transition-all';
      if (btnFacialNight) btnFacialNight.className = 'flex-1 py-1.5 rounded-xl text-white/60 hover:text-white flex items-center justify-center gap-1.5 transition-all';
      stepsDay?.classList.remove('hidden');
      stepsNight?.classList.add('hidden');
      showPhoneToast('☀️ Rutina Facial de la Mañana');
    });

    btnFacialNight?.addEventListener('click', () => {
      if (btnFacialNight) btnFacialNight.className = 'flex-1 py-1.5 rounded-xl bg-[#2D1B32] border border-white/15 text-white flex items-center justify-center gap-1.5 shadow-xs transition-all';
      if (btnFacialDay) btnFacialDay.className = 'flex-1 py-1.5 rounded-xl text-white/60 hover:text-white flex items-center justify-center gap-1.5 transition-all';
      stepsNight?.classList.remove('hidden');
      stepsDay?.classList.add('hidden');
      showPhoneToast('🌙 Rutina Facial de la Noche');
    });

    // Facial Steps Checklist Item Toggle
    const facialStepItems = document.querySelectorAll('.facial-step-item');
    facialStepItems.forEach(item => {
      item.addEventListener('click', () => {
        const checkbox = item.querySelector('.facial-check-box');
        if (!checkbox) return;
        const isChecked = checkbox.classList.contains('bg-[#DF7591]');
        if (isChecked) {
          checkbox.classList.remove('bg-[#DF7591]', 'text-white', 'border-transparent');
          checkbox.classList.add('border-white/30');
          checkbox.textContent = '';
        } else {
          checkbox.classList.add('bg-[#DF7591]', 'text-white', 'border-transparent');
          checkbox.classList.remove('border-white/30');
          checkbox.textContent = '✓';
        }
      });
    });

    // Facial Register Routine Button
    document.getElementById('btn-register-facial')?.addEventListener('click', () => {
      showPhoneToast('✨ ¡Rutina facial registrada con éxito!');
    });

    // Mi Perfil & Navegación a Ajustes
    const btnAjustes = document.getElementById('phone-btn-ajustes');
    btnAjustes?.addEventListener('click', () => {
      showPhoneToast('Abriendo Ajustes ⚙️...');
      setTimeout(() => activateTab('ajustes'), 200);
    });

    // Volver de Ajustes a Mi Perfil con botón [←]
    document.getElementById('phone-ajustes-back-btn')?.addEventListener('click', () => {
      activateTab('perfil');
      showPhoneToast('Mi Perfil 🌸');
    });

    // Acordeón 1: Preferencias de Módulos (Desplegable)
    const btnAccordionModulos = document.getElementById('accordion-btn-modulos');
    const bodyAccordionModulos = document.getElementById('accordion-body-modulos');
    const chevronModulos = document.getElementById('chevron-modulos');
    let modulosExpanded = false;

    btnAccordionModulos?.addEventListener('click', () => {
      modulosExpanded = !modulosExpanded;
      if (modulosExpanded) {
        bodyAccordionModulos?.classList.remove('hidden');
        if (chevronModulos) chevronModulos.textContent = '▲';
        showPhoneToast('Preferencias de Módulos desplegado 🎚️');
      } else {
        bodyAccordionModulos?.classList.add('hidden');
        if (chevronModulos) chevronModulos.textContent = '▼';
      }
    });

    // Switches interactivos dentro de Preferencias de Módulos
    let skincareEnabled = true;
    const toggleSkincare = document.getElementById('ajustes-toggle-skincare');
    toggleSkincare?.addEventListener('click', () => {
      skincareEnabled = !skincareEnabled;
      const knob = toggleSkincare.querySelector('.ajustes-knob');
      if (skincareEnabled) {
        toggleSkincare.classList.remove('bg-stone-700');
        toggleSkincare.classList.add('bg-[#851A3E]');
        knob?.classList.remove('translate-x-0');
        knob?.classList.add('translate-x-3.5');
        showPhoneToast('Módulo Skincare: Habilitado 🧴');
      } else {
        toggleSkincare.classList.remove('bg-[#851A3E]');
        toggleSkincare.classList.add('bg-stone-700');
        knob?.classList.remove('translate-x-3.5');
        knob?.classList.add('translate-x-0');
        showPhoneToast('Módulo Skincare: Ocultado');
      }
    });

    const toggleAjustesPareja = document.getElementById('ajustes-toggle-pareja');
    toggleAjustesPareja?.addEventListener('click', () => {
      partnerEnabled = !partnerEnabled;
      const knob = toggleAjustesPareja.querySelector('.ajustes-knob');
      if (partnerEnabled) {
        toggleAjustesPareja.classList.remove('bg-stone-700');
        toggleAjustesPareja.classList.add('bg-[#851A3E]');
        knob?.classList.remove('translate-x-0');
        knob?.classList.add('translate-x-3.5');
      } else {
        toggleAjustesPareja.classList.remove('bg-[#851A3E]');
        toggleAjustesPareja.classList.add('bg-stone-700');
        knob?.classList.remove('translate-x-3.5');
        knob?.classList.add('translate-x-0');
      }
      updatePartnerHeartUI(true);
    });

    let hydrationEnabled = true;
    const toggleHydration = document.getElementById('ajustes-toggle-hydration');
    toggleHydration?.addEventListener('click', () => {
      hydrationEnabled = !hydrationEnabled;
      const knob = toggleHydration.querySelector('.ajustes-knob');
      if (hydrationEnabled) {
        toggleHydration.classList.remove('bg-stone-700');
        toggleHydration.classList.add('bg-[#851A3E]');
        knob?.classList.remove('translate-x-0');
        knob?.classList.add('translate-x-3.5');
        showPhoneToast('Recordatorios de hidratación activados 💧');
      } else {
        toggleHydration.classList.remove('bg-[#851A3E]');
        toggleHydration.classList.add('bg-stone-700');
        knob?.classList.remove('translate-x-3.5');
        knob?.classList.add('translate-x-0');
        showPhoneToast('Recordatorios de hidratación pausados');
      }
    });

    // Acordeón 2: Herramientas y Cuidados (Desplegable)
    const btnAccordionHerramientas = document.getElementById('accordion-btn-herramientas');
    const bodyAccordionHerramientas = document.getElementById('accordion-body-herramientas');
    const chevronHerramientas = document.getElementById('chevron-herramientas');
    let herramientasExpanded = false;

    btnAccordionHerramientas?.addEventListener('click', () => {
      herramientasExpanded = !herramientasExpanded;
      if (herramientasExpanded) {
        bodyAccordionHerramientas?.classList.remove('hidden');
        if (chevronHerramientas) chevronHerramientas.textContent = '▲';
        showPhoneToast('Herramientas y Cuidados desplegado ✨');
      } else {
        bodyAccordionHerramientas?.classList.add('hidden');
        if (chevronHerramientas) chevronHerramientas.textContent = '▼';
      }
    });

    // Clicks en herramientas
    document.querySelectorAll('.ajustes-tool-item').forEach(tool => {
      tool.addEventListener('click', () => {
        const type = tool.getAttribute('data-tool');
        if (type === 'productos') {
          showPhoneToast('🧴 Mis Productos: Inventario y fechas PAO abierto');
        } else if (type === 'rutinas') {
          showPhoneToast('💆‍♀️ Guía de Rutinas y Cronograma abierto');
        } else if (type === 'pareja') {
          showPhoneToast('💕 Abriendo Modo Pareja sincronizado...');
          setTimeout(() => activateTab('pareja'), 300);
        } else if (type === 'fit') {
          showPhoneToast('🏃‍♀️ Google Fit & Salud: 7.210 pasos sincronizados hoy');
        } else if (type === 'pdf') {
          triggerPdfAction();
        }
      });
    });

    // Acordeón 3: Preferencias de la Aplicación
    const btnAccordionAppPrefs = document.getElementById('accordion-btn-app-prefs');
    const bodyAccordionAppPrefs = document.getElementById('accordion-body-app-prefs');
    const chevronAppPrefs = document.getElementById('chevron-app-prefs');
    let appPrefsExpanded = false;

    btnAccordionAppPrefs?.addEventListener('click', () => {
      appPrefsExpanded = !appPrefsExpanded;
      if (appPrefsExpanded) {
        bodyAccordionAppPrefs?.classList.remove('hidden');
        if (chevronAppPrefs) chevronAppPrefs.textContent = '▲';
      } else {
        bodyAccordionAppPrefs?.classList.add('hidden');
        if (chevronAppPrefs) chevronAppPrefs.textContent = '▼';
      }
    });

    // Cambiar tipo de cabello o piel
    document.querySelectorAll('.ajustes-cambiar-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        showPhoneToast('✏️ Cuestionario de diagnóstico capilar/facial abierto.');
      });
    });

    // Otras tarjetas de ajustes
    document.getElementById('btn-sync-data')?.addEventListener('click', () => {
      showPhoneToast('🔄 Sincronización en la nube al día.');
    });
    document.getElementById('btn-history')?.addEventListener('click', () => {
      showPhoneToast('📊 Historial completo de ciclos y tratamientos.');
    });
    document.getElementById('btn-account')?.addEventListener('click', () => {
      showPhoneToast('⚙️ Cuenta: Camila Gómez (camila.gomez@gmail.com)');
    });
    document.getElementById('btn-actualizar-app')?.addEventListener('click', () => {
      showPhoneToast('✓ Tienes la última versión (v1.2.0) de Luna & Brillo 💕');
    });

    // Mi Perfil: cámara, editar y logout
    document.getElementById('phone-btn-avatar-camera')?.addEventListener('click', () => {
      showPhoneToast('📷 Subir nueva foto de perfil');
    });

    document.getElementById('phone-btn-edit-profile')?.addEventListener('click', () => {
      showPhoneToast('✏️ Editando perfil de Camila');
    });

    document.getElementById('phone-btn-logout')?.addEventListener('click', () => {
      showPhoneToast('🌸 Sesión cerrada con éxito. ¡Hasta pronto, Camila!');
    });
  });
</script>
