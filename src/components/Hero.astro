---
---
<section id="showcase" class="relative pt-8 pb-16 lg:py-20 px-4 sm:px-6 lg:px-12 max-w-7xl mx-auto flex flex-col lg:flex-row items-center gap-12 lg:gap-16 scroll-mt-28">
  
  <!-- Left Side: Copy and Interactive Tab Switchers -->
  <div class="flex-1 text-center lg:text-left z-10">
    <!-- Announcement Badge -->
    <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-[#FCE8EE] border border-[#DF7591]/40 text-[#70163C] text-xs sm:text-sm font-extrabold mb-6 hover:scale-105 transition-transform duration-300 shadow-2xs">
      <span class="flex h-2.5 w-2.5 rounded-full bg-[#DF7591] animate-ping"></span>
      <span>¡Auténtico Modo Oscuro & Modo Pareja en Tiempo Real! ✨</span>
    </div>

    <!-- Main Title -->
    <h1 class="font-display font-bold text-4xl sm:text-5xl lg:text-6xl text-[#2D141E] leading-tight mb-6">
      Brilla con tu propia luz, <br/>
      <span class="bg-gradient-to-r from-[#70163C] via-[#A22C58] to-[#DF7591] bg-clip-text text-transparent relative">
        todos los días 💕
        <!-- Underline decoration -->
        <svg class="absolute left-0 bottom-[-8px] w-full h-3 text-[#DF7591]/40" viewBox="0 0 100 10" preserveAspectRatio="none">
          <path d="M0,5 Q50,10 100,5" stroke="currentColor" stroke-width="4" fill="none" stroke-linecap="round"/>
        </svg>
      </span>
    </h1>

    <!-- Description -->
    <p class="text-[#7A5C68] text-base sm:text-lg font-medium leading-relaxed max-w-xl mx-auto lg:mx-0 mb-8">
      Diseñada para acompañarte en cada momento. Monitorea tu ciclo hormonal en el calendario interactivo, sincroniza con Google Fit, consulta fases lunares precisas, exporta tu reporte médico en PDF y activa el <strong>Modo Pareja</strong> con solo tocar el corazón.
    </p>

    <!-- CTAs -->
    <div class="flex flex-col sm:flex-row justify-center lg:justify-start gap-4 mb-8">
      <a 
        href="#download" 
        class="bg-gradient-to-r from-[#70163C] to-[#8E2150] hover:from-[#8E2150] hover:to-[#70163C] text-white px-7 py-4 rounded-3xl font-extrabold shadow-md hover:shadow-xl transition-all duration-300 hover:-translate-y-1 text-base flex items-center justify-center gap-2.5 group"
      >
        <span>Descargar APK Gratis</span>
        <svg class="w-5 h-5 group-hover:translate-y-0.5 transition-transform" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3"/>
        </svg>
      </a>
      <a 
        href="/pareja.html" 
        target="_blank"
        class="bg-white hover:bg-[#FFF7F9] border-2 border-[#DF7591]/40 text-[#70163C] px-7 py-4 rounded-3xl font-extrabold transition-all duration-300 hover:-translate-y-1 text-base flex items-center justify-center gap-2 shadow-2xs hover:shadow-sm"
      >
        <span>Ver Visor Pareja en Vivo</span>
        <span class="text-sm">↗</span>
      </a>
    </div>

    <!-- Interactive Simulator Controller -->
    <div class="glass-panel p-4 sm:p-5 rounded-3xl border border-[#DF7591]/30 max-w-lg mx-auto lg:mx-0 shadow-sm space-y-3.5">
      <div class="flex items-center justify-between">
        <p class="text-xs text-[#70163C] font-extrabold uppercase tracking-wider flex items-center gap-1.5">
          <span>📱</span>
          <span>Prueba las pantallas reales de la app:</span>
        </p>
        <span class="text-[10px] text-stone-400 font-semibold">Toca para cambiar</span>
      </div>

      <!-- Tab Buttons Grid -->
      <!-- Tab Buttons Grid (Matching real app tabs) -->
      <div class="grid grid-cols-3 sm:grid-cols-5 gap-2">
        <button 
          id="btn-tab-inicio" 
          class="hero-tab-btn active bg-[#70163C] text-white py-2.5 px-2 rounded-2xl font-bold text-xs shadow-xs transition-all duration-300 hover:scale-102 flex flex-col items-center gap-1"
        >
          <span class="text-base">✨</span>
          <span>Inicio</span>
        </button>

        <button 
          id="btn-tab-ciclo" 
          class="hero-tab-btn bg-white hover:bg-[#FCE8EE] text-[#7A5C68] py-2.5 px-2 rounded-2xl font-bold text-xs border border-[#DF7591]/30 transition-all duration-300 hover:scale-102 flex flex-col items-center gap-1"
        >
          <span class="text-base">🌙</span>
          <span>Mi Ciclo</span>
        </button>

        <button 
          id="btn-tab-cabello" 
          class="hero-tab-btn bg-white hover:bg-[#FCE8EE] text-[#7A5C68] py-2.5 px-2 rounded-2xl font-bold text-xs border border-[#DF7591]/30 transition-all duration-300 hover:scale-102 flex flex-col items-center gap-1"
        >
          <span class="text-base">💆‍♀️</span>
          <span>Cabello</span>
        </button>

        <button 
          id="btn-tab-piel" 
          class="hero-tab-btn bg-white hover:bg-[#FCE8EE] text-[#7A5C68] py-2.5 px-2 rounded-2xl font-bold text-xs border border-[#DF7591]/30 transition-all duration-300 hover:scale-102 flex flex-col items-center gap-1"
        >
          <span class="text-base">🧴</span>
          <span>Facial</span>
        </button>

        <button 
          id="btn-tab-perfil" 
          class="hero-tab-btn bg-white hover:bg-[#FCE8EE] text-[#7A5C68] py-2.5 px-2 rounded-2xl font-bold text-xs border border-[#DF7591]/30 transition-all duration-300 hover:scale-102 flex flex-col items-center gap-1"
        >
          <span class="text-base">🌸</span>
          <span>Perfil</span>
        </button>
      </div>

      <!-- Feature Interactive Quick Toggles (Heart & PDF & Partner Screen) -->
      <div class="pt-2 border-t border-[#DF7591]/20 flex flex-wrap items-center justify-between gap-2.5 text-xs">
        <div class="flex items-center gap-2">
          <span class="text-[11px] font-bold text-[#2D141E]">Modo Pareja en Mi Ciclo:</span>
          <button 
            id="toggle-partner-heart-mode"
            class="px-2.5 py-1 rounded-full text-[10px] font-extrabold bg-[#FCE8EE] text-[#70163C] border border-[#DF7591]/40 hover:scale-105 active:scale-95 transition-all flex items-center gap-1"
          >
            <span id="partner-toggle-icon">💖</span>
            <span id="partner-toggle-text">Habilitado</span>
          </button>
        </div>

        <div class="flex items-center gap-3">
          <button 
            id="btn-tab-pareja"
            class="text-[10px] font-extrabold text-[#70163C] hover:underline flex items-center gap-1"
          >
            <span>💕 Ver Vista Pareja</span>
          </button>
          <button 
            id="btn-tab-ajustes-outside"
            class="text-[10px] font-extrabold text-[#70163C] hover:underline flex items-center gap-1"
          >
            <span>⚙️ Ajustes</span>
          </button>
          <button 
            id="btn-trigger-pdf-outside"
            class="text-[10px] font-extrabold text-[#70163C] hover:underline flex items-center gap-1"
          >
            <span>📄 Reporte PDF</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Right Side: Floating Smartphone Mockup (Dark Mode 1:1) -->
  <div class="flex-1 flex justify-center items-center relative py-6 w-full">
    
    <!-- Floating Sparkles & Soft Lights around Phone -->
    <div class="absolute -top-6 -left-6 w-10 h-10 text-[#DF7591] opacity-40 animate-pulse-slow">
      <svg fill="currentColor" viewBox="0 0 24 24"><path d="M12 0L14.6 9.4L24 12L14.6 14.6L12 24L9.4 14.6L0 12L9.4 9.4L12 0Z"/></svg>
    </div>
    <div class="absolute bottom-6 right-2 w-12 h-12 text-[#70163C] opacity-30 animate-float" style="animation-duration: 7s;">
      <svg fill="currentColor" viewBox="0 0 24 24"><path d="M12 0L14.6 9.4L24 12L14.6 14.6L12 24L9.4 14.6L0 12L9.4 9.4L12 0Z"/></svg>
    </div>
    <div class="absolute top-[50%] -right-8 w-8 h-8 text-[#E8A598] opacity-50 animate-float" style="animation-duration: 5s;">
      <svg fill="currentColor" viewBox="0 0 24 24"><path d="M12 0L14.6 9.4L24 12L14.6 14.6L12 24L9.4 14.6L0 12L9.4 9.4L12 0Z"/></svg>
    </div>

    <!-- Phone Wrapper Frame -->
    <div class="relative w-[320px] sm:w-[350px] h-[670px] sm:h-[710px] bg-[#0c080d] rounded-[52px] border-[10px] border-[#221724] shadow-2xl overflow-hidden flex flex-col">
      
      <!-- Top Speaker / Camera Island -->
      <div class="absolute top-2 left-1/2 -translate-x-1/2 w-32 h-6 bg-[#0c080d] rounded-b-2xl z-30 flex items-center justify-center">
        <div class="w-3.5 h-3.5 bg-[#221724] rounded-full border border-white/10 flex items-center justify-center">
          <div class="w-1.5 h-1.5 bg-[#050306] rounded-full"></div>
        </div>
      </div>

      <!-- Smartphone Internal Screen Viewport (Dark Theme #130D15) -->
      <div class="relative flex-1 bg-[#130D15] text-white flex flex-col justify-between overflow-hidden font-sans select-none">
        
        <!-- Status Bar (Matching Screenshots: 8:41, alarm, battery 44%) -->
        <div class="pt-8 px-5 flex justify-between items-center text-[10px] font-semibold text-white/80 z-20 bg-[#130D15] border-b border-white/5">
          <span class="font-bold">8:41</span>
          <div class="flex items-center gap-1.5 text-[9px]">
            <span>⏰</span>
            <span>📶</span>
            <span class="text-[8px] bg-white/20 px-1 rounded">VoLTE</span>
            <span class="border border-white/60 px-1 py-0.2 rounded text-[7.5px] font-bold">44</span>
          </div>
        </div>

        <!-- Phone Dynamic Scrollable Content -->
        <div class="flex-1 p-3.5 overflow-y-auto z-10 flex flex-col space-y-3 relative text-white">
          
          <!-- ============================================== -->
          <!-- 1. SCREEN INICIO (Dark Theme - Screenshot 1) -->
          <!-- ============================================== -->
          <div id="mockup-screen-inicio" class="mockup-screen opacity-100 transition-all duration-300 flex-1 space-y-3">
            
            <!-- Header: Avatar + ¡Buenas noches, hermosa! 💕 -->
            <div class="flex items-center gap-3 pt-1 pb-1">
              <div class="w-11 h-11 rounded-full bg-[#FCE8EE] p-0.5 flex items-center justify-center flex-shrink-0 shadow-sm border border-white/10">
                <img src="/logo.png" alt="Usuario" class="w-full h-full object-contain rounded-full" />
              </div>
              <div class="leading-tight">
                <h4 id="phone-greeting" class="font-bold text-sm text-white flex items-center gap-1">
                  <span>¡Buenas noches, hermosa!</span>
                  <span>💕</span>
                </h4>
                <p id="phone-date" class="text-[9.5px] text-[#A795A0] font-medium mt-0.5">viernes 23 de octubre</p>
              </div>
            </div>

            <!-- Card 1: 🌸 AFIRMACIÓN DEL DÍA -->
            <div class="bg-[#221626] p-3.5 rounded-2xl border border-white/5 shadow-xs relative">
              <div class="flex items-center justify-between mb-2">
                <div class="flex items-center gap-1.5 text-[10px] font-extrabold text-[#DF7591] uppercase tracking-wide">
                  <span>🌸</span>
                  <span>Afirmación del día</span>
                </div>
                <button class="text-white/60 hover:text-[#DF7591] transition-colors text-xs">
                  ♡
                </button>
              </div>
              <p class="text-[10px] text-white/90 italic font-normal leading-relaxed">
                “Hidrata tu cuerpo, cuida tu cabello y regálate momentos de calma. Te mereces todo el amor que das.”
              </p>
              <div class="text-right mt-1.5">
                <span class="text-[8.5px] text-[#A795A0] font-medium">— Luna & Brillo</span>
              </div>
            </div>

            <!-- Card 2: FASE LUNAR DE HOY ✨ (Gibosa Creciente) -->
            <div class="bg-[#221626] p-3.5 rounded-2xl border border-white/5 shadow-xs relative overflow-hidden">
              <!-- Glow on right -->
              <div class="absolute -right-6 -bottom-6 w-24 h-24 bg-purple-900/20 rounded-full blur-xl pointer-events-none"></div>

              <div class="flex items-center gap-3 mb-2.5">
                <div class="w-10 h-10 rounded-full bg-[#2E1E33] flex items-center justify-center text-xl flex-shrink-0 shadow-inner">
                  🌖
                </div>
                <div>
                  <div class="flex items-center gap-1 text-[9px] font-extrabold text-[#DF7591] uppercase tracking-wider">
                    <span>Fase lunar de hoy</span>
                    <span class="text-amber-300">✨</span>
                  </div>
                  <h5 class="font-bold text-xs sm:text-sm text-white leading-tight">Luna Gibosa Creciente</h5>
                </div>
              </div>

              <!-- Recommendation Inner Box -->
              <div class="bg-[#170E1A] p-2.5 rounded-xl border border-white/5 flex items-start gap-2 text-[9px] text-white/90 leading-tight">
                <span class="text-xs">✂️</span>
                <span>Fase excelente para cortar el cabello si quieres que crezca abundante y rápido.</span>
              </div>
            </div>

            <!-- Card 3: Google Fit & Actividad (Screenshot 1) -->
            <div class="bg-[#1C1722] p-3.5 rounded-2xl border border-emerald-500/20 shadow-xs relative">
              <div class="flex items-center justify-between mb-2">
                <div class="flex items-center gap-2">
                  <div class="w-7 h-7 rounded-xl bg-emerald-950/60 border border-emerald-500/30 flex items-center justify-center text-xs">
                    🏃‍♀️
                  </div>
                  <div>
                    <h5 class="font-bold text-xs text-white leading-tight">Google Fit & Activi...</h5>
                    <span class="text-[8px] text-[#A795A0]">Sync: 11:16 p. m.</span>
                  </div>
                </div>
                <div class="flex items-center gap-1 px-2 py-0.5 rounded-full border border-emerald-500/40 bg-emerald-950/30 text-emerald-400 text-[8px] font-bold">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                  <span>Conectado</span>
                </div>
              </div>

              <!-- Big Steps & 90% -->
              <div class="flex items-baseline justify-between mt-2 mb-1">
                <div class="flex items-baseline gap-1">
                  <span class="text-lg font-extrabold text-white">7.210</span>
                  <span class="text-[9px] text-[#A795A0] font-semibold">/ 8.000 pasos</span>
                </div>
                <span class="text-xs font-bold text-emerald-400">90%</span>
              </div>

              <!-- Green Progress Bar -->
              <div class="w-full h-1.5 bg-black/40 rounded-full overflow-hidden mb-2.5">
                <div class="h-full bg-emerald-400 rounded-full w-[90%] transition-all duration-1000"></div>
              </div>

              <!-- Mini Pills Row -->
              <div class="flex items-center justify-between text-[8px]">
                <div class="flex items-center gap-2">
                  <span class="bg-[#150F1A] px-2 py-1 rounded-lg text-white/90 font-medium flex items-center gap-1">
                    <span>⏱️</span> 42 min
                  </span>
                  <span class="bg-[#150F1A] px-2 py-1 rounded-lg text-white/90 font-medium flex items-center gap-1">
                    <span>🔥</span> 310 kcal
                  </span>
                </div>
                <span class="text-[#A795A0] font-bold text-xs">›</span>
              </div>
            </div>

            <!-- Card 4: Peek of Próximo Ciclo -->
            <div class="bg-gradient-to-r from-[#70163C] to-[#A22C58] p-2.5 rounded-xl text-white opacity-80 cursor-pointer hover:opacity-100 transition-opacity" id="peek-ciclo-btn">
              <div class="flex items-center justify-between text-[9px] font-bold">
                <span>🌙 Próximo Ciclo: En 5 días</span>
                <span>Ver calendario ›</span>
              </div>
            </div>

          </div>

          <!-- ============================================== -->
          <!-- 2. SCREEN MI CICLO (Dark Theme - Screenshot 2) -->
          <!-- ============================================== -->
          <div id="mockup-screen-ciclo" class="mockup-screen hidden opacity-0 transition-all duration-300 flex-1 space-y-3">
            
            <!-- Top Bar: Mi Ciclo 🌙 + [💖 Corazón Modo Pareja] + [📄 PDF] -->
            <div class="flex items-center justify-between pt-1 pb-1">
              <div></div> <!-- spacer -->
              
              <h4 class="font-bold text-sm text-white flex items-center gap-1 pl-6">
                <span>Mi Ciclo</span>
                <span class="text-amber-300">🌙</span>
              </h4>

              <div class="flex items-center gap-2">
                <!-- ❤️ Corazón Modo Pareja (Interactivo: cuando está habilitado se muestra, cuando no se quita) -->
                <button 
                  id="phone-ciclo-heart-btn"
                  class="text-sm p-1 rounded-full text-[#DF7591] hover:scale-110 active:scale-95 transition-all"
                  title="Modo Pareja Habilitado (Toca para probar)"
                >
                  <span class="filter drop-shadow-[0_0_6px_rgba(223,117,145,0.7)]">💖</span>
                </button>

                <!-- 📄 Icono PDF Reporte de Salud (Interactivo) -->
                <button 
                  id="phone-ciclo-pdf-btn"
                  class="flex items-center justify-center w-6 h-6 rounded-md bg-white/10 hover:bg-white/20 border border-white/20 text-[9px] font-extrabold text-white tracking-tighter hover:scale-105 active:scale-95 transition-all"
                  title="Exportar Reporte Médico en PDF"
                >
                  <span>PDF</span>
                </button>
              </div>
            </div>

            <!-- Top Card: Próximo periodo estimado (Gradient Plum to Rose) -->
            <div class="bg-gradient-to-r from-[#801C3E] via-[#A63C5C] to-[#D2768E] p-3.5 rounded-2xl text-white shadow-sm flex items-center justify-between">
              <div>
                <div class="flex items-center gap-1.5 text-xs font-bold">
                  <span>📅</span>
                  <span>Próximo periodo estimado</span>
                </div>
                <p class="text-[9px] text-white/90 mt-1 font-medium">En 5 días • 29 oct</p>
              </div>
              <!-- Floating Translucent Box with 5 días -->
              <div class="bg-white/20 backdrop-blur-md rounded-2xl px-3 py-1.5 text-center border border-white/30 flex flex-col items-center justify-center">
                <span class="text-sm font-extrabold leading-none">5</span>
                <span class="text-[8px] font-bold opacity-90 leading-tight">días</span>
              </div>
            </div>

            <!-- Calendar Card: October 2026 (1:1 with Screenshot 2) -->
            <div class="bg-[#221626] p-3.5 rounded-2xl border border-white/5 shadow-xs">
              <!-- Calendar Header: < October 2026 > -->
              <div class="flex items-center justify-between mb-3 text-xs font-bold text-white px-1">
                <button class="text-[#DF7591] hover:text-white transition-colors">‹</button>
                <span>October 2026</span>
                <button class="text-[#DF7591] hover:text-white transition-colors">›</button>
              </div>

              <!-- Day Names -->
              <div class="grid grid-cols-7 text-center text-[8.5px] font-bold text-[#A795A0] mb-2">
                <span>Sun</span>
                <span>Mon</span>
                <span>Tue</span>
                <span>Wed</span>
                <span>Thu</span>
                <span>Fri</span>
                <span>Sat</span>
              </div>

              <!-- Days Grid (October 2026 starting on Thu 1) -->
              <div class="grid grid-cols-7 text-center text-[9px] font-medium gap-y-2 text-white">
                <!-- Week 1: 1st on Thu -->
                <span class="opacity-0"></span>
                <span class="opacity-0"></span>
                <span class="opacity-0"></span>
                <span class="opacity-0"></span>
                <span>1</span>
                <span>2</span>
                <span>3</span>

                <!-- Week 2: 4 to 10 with Menstrual Dots on 4, 5, 6, 7, 8 -->
                <div class="flex flex-col items-center">
                  <span>4</span>
                  <span class="w-1 h-1 rounded-full bg-[#DF7591] mt-0.5"></span>
                </div>
                <div class="flex flex-col items-center">
                  <span>5</span>
                  <span class="w-1 h-1 rounded-full bg-[#DF7591] mt-0.5"></span>
                </div>
                <div class="flex flex-col items-center">
                  <span>6</span>
                  <span class="w-1 h-1 rounded-full bg-[#DF7591] mt-0.5"></span>
                </div>
                <div class="flex flex-col items-center">
                  <span>7</span>
                  <span class="w-1 h-1 rounded-full bg-[#DF7591] mt-0.5"></span>
                </div>
                <div class="flex flex-col items-center">
                  <span>8</span>
                  <span class="w-1 h-1 rounded-full bg-[#DF7591] mt-0.5"></span>
                </div>
                <span>9</span>
                <span>10</span>

                <!-- Week 3: 11 to 17 -->
                <span>11</span>
                <span>12</span>
                <span>13</span>
                <span>14</span>
                <span>15</span>
                <span>16</span>
                <span>17</span>

                <!-- Week 4: 18 to 24 with Day 23 Highlighted Circle -->
                <span>18</span>
                <span>19</span>
                <span>20</span>
                <span>21</span>
                <span>22</span>
                <div class="flex items-center justify-center">
                  <span class="w-5 h-5 rounded-full border-2 border-[#DF7591] text-[#DF7591] font-bold flex items-center justify-center text-[9px]">23</span>
                </div>
                <span>24</span>

                <!-- Week 5: 25 to 31 -->
                <span>25</span>
                <span>26</span>
                <span>27</span>
                <span>28</span>
                <span>29</span>
                <span>30</span>
                <span>31</span>
              </div>
            </div>

            <!-- Floating Action Button (+ Registrar in burgundy) -->
            <div class="flex justify-end pt-1">
              <button 
                id="phone-btn-registrar"
                class="bg-[#851A3E] hover:bg-[#A63C5C] text-white text-[10px] font-extrabold px-4 py-2 rounded-2xl shadow-md flex items-center gap-1.5 active:scale-95 transition-transform"
              >
                <span class="text-xs">+</span>
                <span>Registrar</span>
              </button>
            </div>

          </div>

          <!-- ============================================== -->
          <!-- 3. SCREEN MODO PAREJA (Dark Theme) -->
          <!-- ============================================== -->
          <div id="mockup-screen-pareja" class="mockup-screen hidden opacity-0 transition-all duration-300 flex-1 space-y-3">
            <div class="flex items-center justify-between pt-1">
              <span class="text-[9.5px] font-extrabold uppercase tracking-wide text-[#DF7591] flex items-center gap-1">
                <span>💕</span> Modo Pareja en Tiempo Real
              </span>
              <span class="text-[8px] bg-[#25D366]/20 text-[#4ADE80] font-bold px-2 py-0.5 rounded-full">Sincronizado</span>
            </div>

            <!-- Visualizador Glassmorphic Pareja -->
            <div class="bg-gradient-to-br from-[#801C3E] to-[#DF7591] text-white p-3.5 rounded-2xl shadow-xs">
