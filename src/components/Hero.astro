          <!-- 3. Cabello -->
          <button id="phone-nav-cabello" class="phone-nav-item text-stone-400 hover:text-stone-600 flex flex-col items-center gap-0.5">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v18M12 3c-2.5 4-5 6-8 7.5 4 .5 7-1.5 8-4.5M12 3c2.5 4 5 6 8 7.5-4 .5-7-1.5-8-4.5M12 9c-2 3.5-4.5 5-7.5 5.5 3.5 0 6.5-2.5 7.5-5.5M12 9c2 3.5 4.5 5 7.5 5.5-3.5 0-6.5-2.5-7.5-5.5" />
            </svg>
            <span class="text-[7.5px] font-extrabold">Cabello</span>
          </button>

          <!-- 4. Piel -->
          <button id="phone-nav-piel" class="phone-nav-item text-stone-400 hover:text-stone-600 flex flex-col items-center gap-0.5">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.182 15.182a4.5 4.5 0 0 1-6.364 0M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3M12 3v2.25M12 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
            </svg>
            <span class="text-[7.5px] font-extrabold">Piel</span>
          </button>

          <!-- 5. Perfil -->
          <button id="phone-nav-perfil" class="phone-nav-item text-stone-400 hover:text-stone-600 flex flex-col items-center gap-0.5">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
            </svg>
            <span class="text-[7.5px] font-extrabold">Perfil</span>
          </button>
        </div>

      </div>
    </div>
  </div>

</section>

<!-- Vanilla JavaScript Client-Side Code -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Buttons in Landing Page Hero
    const btnCiclo = document.getElementById('btn-ciclo');
    const btnCabello = document.getElementById('btn-cabello');
    const btnPiel = document.getElementById('btn-piel');

    // Phone Bottom Nav Items
    const navInicio = document.getElementById('phone-nav-inicio');
    const navCiclo = document.getElementById('phone-nav-ciclo');
    const navCabello = document.getElementById('phone-nav-cabello');
    const navPiel = document.getElementById('phone-nav-piel');
    const navPerfil = document.getElementById('phone-nav-perfil');

    // Screen Views inside the Mockup
    const screenInicio = document.getElementById('screen-content-inicio');
    const screenCiclo = document.getElementById('screen-content-ciclo');
    const screenCabello = document.getElementById('screen-content-cabello');
    const screenPiel = document.getElementById('screen-content-piel');
    const screenPerfil = document.getElementById('screen-content-perfil');

    // Array of tabs/views mapping
    const tabs = [
      {
        controlBtn: null,
        navBtn: navInicio,
        screen: screenInicio,
        id: 'inicio'
      },
      {
        controlBtn: btnCiclo,
        navBtn: navCiclo,
        screen: screenCiclo,
        id: 'ciclo'
      },
      {
        controlBtn: btnCabello,
        navBtn: navCabello,
        screen: screenCabello,
        id: 'cabello'
      },
      {
        controlBtn: btnPiel,
        navBtn: navPiel,
        screen: screenPiel,
        id: 'piel'
      },
      {
        controlBtn: null,
        navBtn: navPerfil,
        screen: screenPerfil,
        id: 'perfil'
      }
    ];

    // Function to switch tabs
    function switchTab(targetId) {
      // Also always hide Ajustes if switching to any other bottom tab
      const screenAjustes = document.getElementById('screen-content-ajustes');
      if (screenAjustes) {
        screenAjustes.classList.remove('opacity-100');
        screenAjustes.classList.add('opacity-0');
        screenAjustes.classList.add('hidden');
      }

      tabs.forEach(tab => {
        if (tab.id === targetId) {
          // Activate control button (if exists)
          if (tab.controlBtn) {
            tab.controlBtn.classList.remove('bg-white', 'text-stone-700', 'border', 'border-brand-soft-pink', 'hover:bg-brand-soft-pink/50');
            tab.controlBtn.classList.add('bg-brand-peach', 'text-white', 'shadow-xs');
            tab.controlBtn.classList.add('tab-btn', 'active');
          }
          
          // Activate Phone Nav Button
          tab.navBtn?.classList.remove('text-stone-400', 'hover:text-stone-600');
          tab.navBtn?.classList.add('text-brand-peach');

          // Show Screen (with fade-in animation)
          if (tab.screen) {
            tab.screen.classList.remove('hidden');
            setTimeout(() => {
              tab.screen.classList.add('opacity-100');
              tab.screen.classList.remove('opacity-0');
            }, 10);
          }
        } else {
          // Deactivate control button (if exists)
          if (tab.controlBtn) {
            tab.controlBtn.classList.remove('bg-brand-peach', 'text-white', 'shadow-xs', 'active');
            tab.controlBtn.classList.add('bg-white', 'text-stone-700', 'border', 'border-brand-soft-pink', 'hover:bg-brand-soft-pink/50');
          }
          
          // Deactivate Phone Nav Button
          tab.navBtn?.classList.remove('text-brand-peach');
          tab.navBtn?.classList.add('text-stone-400', 'hover:text-stone-600');

          // Hide Screen
          if (tab.screen) {
            tab.screen.classList.remove('opacity-100');
            tab.screen.classList.add('opacity-0');
            tab.screen.classList.add('hidden');
          }
        }
      });
    }

    // Add click event listeners
    tabs.forEach(tab => {
      tab.controlBtn?.addEventListener('click', () => switchTab(tab.id));
      tab.navBtn?.addEventListener('click', () => switchTab(tab.id));
    });

    // Ajustes screen elements & sub-navigation
    const btnOpenAjustes = document.getElementById('btn-open-ajustes');
    const btnBackAjustes = document.getElementById('btn-back-ajustes');
    const screenAjustes = document.getElementById('screen-content-ajustes');

    btnOpenAjustes?.addEventListener('click', () => {
      // Hide all main tab screens
      tabs.forEach(tab => {
        if (tab.screen) {
          tab.screen.classList.remove('opacity-100');
          tab.screen.classList.add('opacity-0');
          tab.screen.classList.add('hidden');
        }
      });
      // Show screen Ajustes
      if (screenAjustes) {
        screenAjustes.classList.remove('hidden');
        setTimeout(() => {
          screenAjustes.classList.add('opacity-100');
          screenAjustes.classList.remove('opacity-0');
        }, 10);
      }
    });

    btnBackAjustes?.addEventListener('click', () => {
      // Hide screen Ajustes
      if (screenAjustes) {
        screenAjustes.classList.remove('opacity-100');
        screenAjustes.classList.add('opacity-0');
        screenAjustes.classList.add('hidden');
      }
      // Show screen Perfil again
      if (screenPerfil) {
        screenPerfil.classList.remove('hidden');
        setTimeout(() => {
          screenPerfil.classList.add('opacity-100');
          screenPerfil.classList.remove('opacity-0');
        }, 10);
      }
    });

    // Skincare Screen specific logic (Morning/Night toggle inside Mockup)
    const skinDayBtn = document.getElementById('screen-skin-day-btn');
    const skinNightBtn = document.getElementById('screen-skin-night-btn');
    const routineDay = document.getElementById('skin-routine-day');
    const routineNight = document.getElementById('skin-routine-night');

    function toggleSkinRoutine(isDay) {
      if (isDay) {
        skinDayBtn?.classList.add('bg-brand-peach', 'text-white');
        skinDayBtn?.classList.remove('text-stone-500', 'hover:bg-stone-50/50');
        
        skinNightBtn?.classList.remove('bg-brand-peach', 'text-white');
        skinNightBtn?.classList.add('text-stone-500', 'hover:bg-stone-50/50');

        routineDay?.classList.remove('hidden');
        routineNight?.classList.add('hidden');
      } else {
        skinNightBtn?.classList.add('bg-brand-peach', 'text-white');
        skinNightBtn?.classList.remove('text-stone-500', 'hover:bg-stone-50/50');
        
        skinDayBtn?.classList.remove('bg-brand-peach', 'text-white');
        skinDayBtn?.classList.add('text-stone-500', 'hover:bg-stone-50/50');

        routineNight?.classList.remove('hidden');
        routineDay?.classList.add('hidden');
      }
    }

    // Dynamic greeting based on current local time
    const mockupGreeting = document.getElementById('mockup-greeting');
    if (mockupGreeting) {
      const currentHour = new Date().getHours();
      let greetingText = '¡Buenas noches, Camila! 🌙';
      if (currentHour >= 6 && currentHour < 12) {
        greetingText = '¡Buenos días, Camila! ☀️';
      } else if (currentHour >= 12 && currentHour < 19) {
        greetingText = '¡Buenas tardes, Camila! 🌤️';
      }
      mockupGreeting.textContent = greetingText;
    }

    skinDayBtn?.addEventListener('click', () => toggleSkinRoutine(true));
    skinNightBtn?.addEventListener('click', () => toggleSkinRoutine(false));
  });
</script>
