---
---
<section id="download" class="py-20 px-4 sm:px-6 lg:px-12 max-w-5xl mx-auto scroll-mt-28">
  
  <div class="relative bg-gradient-to-br from-[#70163C] via-[#8E2150] to-[#DF7591] p-8 sm:p-12 md:p-16 rounded-[44px] shadow-2xl text-white overflow-hidden border border-white/20">
    
    <!-- Sparkles and circles in background -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none opacity-20">
      <div class="absolute -top-12 -left-12 w-72 h-72 rounded-full bg-white blur-3xl"></div>
      <div class="absolute -bottom-16 -right-16 w-80 h-80 rounded-full bg-[#E8A598] blur-3xl"></div>
      
      <!-- Shiny sparkles SVG -->
      <div class="absolute top-[20%] right-[10%] w-10 h-10 text-white">
        <svg fill="currentColor" viewBox="0 0 24 24"><path d="M12 0L14.6 9.4L24 12L14.6 14.6L12 24L9.4 14.6L0 12L9.4 9.4L12 0Z"/></svg>
      </div>
      <div class="absolute bottom-[20%] left-[10%] w-8 h-8 text-[#F4C430]">
        <svg fill="currentColor" viewBox="0 0 24 24"><path d="M12 0L14.6 9.4L24 12L14.6 14.6L12 24L9.4 14.6L0 12L9.4 9.4L12 0Z"/></svg>
      </div>
    </div>

    <!-- Main Content -->
    <div class="relative z-10 text-center max-w-3xl mx-auto flex flex-col items-center">
      <!-- Icon badge -->
      <div class="w-16 h-16 bg-white/20 rounded-2xl flex items-center justify-center mb-6 shadow-sm border border-white/30 backdrop-blur-md">
        <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" />
        </svg>
      </div>

      <div class="inline-flex items-center gap-2 px-4 py-1 rounded-full bg-white/20 text-xs font-bold text-white mb-3 backdrop-blur-md border border-white/25">
        <span>✨ Actualización Mayor Disponible</span>
      </div>

      <h2 class="font-display font-bold text-3xl sm:text-4xl lg:text-5xl mb-4 leading-tight">
        ¡Descarga la nueva versión de Luna & Brillo! 🚀
      </h2>
      <p class="text-white/90 font-medium text-base sm:text-lg mb-4 leading-relaxed max-w-xl">
        Disfruta del <strong>Modo Pareja</strong>, sincronización con <strong>Google Fit</strong>, inventario de cosméticos con alertas de caducidad y widgets nativos para tu pantalla de inicio.
      </p>

      <!-- Highlights Pills -->
      <div class="flex flex-wrap justify-center gap-2.5 mb-8">
        <span class="inline-flex items-center gap-1.5 bg-white/15 border border-white/25 text-white text-xs font-bold px-3 py-1.5 rounded-full">
          💕 Modo Pareja Web en Vivo
        </span>
        <span class="inline-flex items-center gap-1.5 bg-white/15 border border-white/25 text-white text-xs font-bold px-3 py-1.5 rounded-full">
          🧴 Inventario & Caducidades
        </span>
        <span class="inline-flex items-center gap-1.5 bg-white/15 border border-white/25 text-white text-xs font-bold px-3 py-1.5 rounded-full">
          ⌚ Conectividad Google Fit
        </span>
        <span class="inline-flex items-center gap-1.5 bg-white/15 border border-white/25 text-white text-xs font-bold px-3 py-1.5 rounded-full">
          📄 Reportes Médicos en PDF
        </span>
      </div>

      <!-- Direct APK Download Section with QR Code -->
      <div class="flex flex-col md:flex-row items-center gap-8 justify-center mb-12 w-full">
        <!-- Left: Download Button & Info -->
        <div class="flex flex-col items-center md:items-start gap-3">
          <a 
            href="https://github.com/TatianaAB-18/Luna-BrilloV/releases/download/1.0.1/app-release.apk"
            class="bg-white hover:bg-[#FFF7F9] text-[#70163C] px-8 py-4.5 rounded-3xl font-extrabold shadow-md hover:shadow-2xl transition-all duration-300 hover:-translate-y-1 text-base sm:text-lg flex items-center justify-center gap-3 w-full sm:w-auto group"
          >
            <svg class="w-6 h-6 group-hover:animate-bounce" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3"/>
            </svg>
            <span>Descargar APK Directo</span>
          </a>
          <p class="text-[11px] text-white/80 font-semibold uppercase tracking-wider text-center md:text-left">
            Compatible con Android 8.0 o superior • Actualizaciones In-App
          </p>
        </div>
        
        <!-- Divider -->
        <span class="hidden md:block text-sm font-bold text-white/50 uppercase tracking-widest">o</span>

        <!-- Right: QR Code -->
        <div class="flex items-center gap-4 bg-white/15 p-3.5 rounded-3xl border border-white/25 shadow-xs hover:scale-102 transition-transform duration-300 max-w-[280px] backdrop-blur-md">
          <div class="w-20 h-20 bg-white rounded-2xl flex items-center justify-center p-1.5 border border-white/20 shadow-3xs flex-shrink-0 overflow-hidden">
            <img 
              src="https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=https://github.com/TatianaAB-18/Luna-BrilloV/releases/download/1.0.1/app-release.apk&color=70163c&bgcolor=ffffff&qzone=1" 
              alt="Código QR de descarga Luna y Brillo" 
              class="w-full h-full rounded-xl object-contain"
              loading="lazy"
            />
          </div>
          <div class="text-left">
            <h4 class="font-bold text-xs text-white leading-tight">Escanea con tu cámara</h4>
            <p class="text-[10px] text-white/85 mt-1 font-medium leading-normal">
              Apunta con la cámara de tu teléfono para descargar el archivo APK inmediatamente.
            </p>
          </div>
        </div>
      </div>

      <!-- Quick Step Guide -->
      <div class="w-full border-t border-white/20 pt-10">
        <h3 class="font-display font-bold text-lg mb-6 tracking-wide text-white">¿Cómo instalar el archivo APK en 3 sencillos pasos?</h3>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-left">
          
          <!-- Step 1 -->
          <div class="bg-white/10 p-5 rounded-2xl border border-white/15 flex items-start gap-4">
            <span class="w-8 h-8 rounded-full bg-white text-[#70163C] font-bold flex items-center justify-center flex-shrink-0 text-sm shadow-xs">1</span>
            <div>
              <h4 class="font-bold text-sm mb-1 text-white">Descarga el Archivo</h4>
              <p class="text-[11px] text-white/80 leading-relaxed font-medium">Haz clic en el botón de arriba para iniciar la descarga segura de <b>app-release.apk</b>.</p>
            </div>
          </div>

          <!-- Step 2 -->
          <div class="bg-white/10 p-5 rounded-2xl border border-white/15 flex items-start gap-4">
            <span class="w-8 h-8 rounded-full bg-white text-[#70163C] font-bold flex items-center justify-center flex-shrink-0 text-sm shadow-xs">2</span>
            <div>
              <h4 class="font-bold text-sm mb-1 text-white">Permitir Instalación</h4>
              <p class="text-[11px] text-white/80 leading-relaxed font-medium">Si tu navegador te lo solicita, activa "Permitir instalar aplicaciones desde esta fuente".</p>
            </div>
          </div>

          <!-- Step 3 -->
          <div class="bg-white/10 p-5 rounded-2xl border border-white/15 flex items-start gap-4">
            <span class="w-8 h-8 rounded-full bg-white text-[#70163C] font-bold flex items-center justify-center flex-shrink-0 text-sm shadow-xs">3</span>
            <div>
              <h4 class="font-bold text-sm mb-1 text-white">¡Abre y Disfruta!</h4>
              <p class="text-[11px] text-white/80 leading-relaxed font-medium">Toca "Instalar" y abre Luna & Brillo para comenzar tu viaje de autocuidado y sincronización.</p>
            </div>
          </div>

        </div>
      </div>

    </div>

  </div>

</section>
