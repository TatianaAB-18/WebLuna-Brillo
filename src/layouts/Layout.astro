---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Luna y Brillo 💕 | Tu App Móvil de Cuidado Personal & Modo Pareja", 
  description = "Descubre Luna y Brillo: Monitoreo estético de ciclo menstrual, Modo Pareja en tiempo real con visor glassmorphism, cronograma capilar inteligente, rutinas de skincare, Google Fit y reportes médicos en PDF."
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <meta name="theme-color" content="#70163C" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Smart Redirection for Partner Links (Preserving parameters & hash) -->
    <script is:inline>
      (function() {
        try {
          var hash = window.location.hash || '';
          var search = window.location.search || '';
          if (hash.includes('data=') || search.includes('data=') || search.includes('uid=') || search.includes('partner=')) {
            window.location.replace('/pareja.html' + search + hash);
          }
        } catch(e) {
          console.warn('Redirect evaluation:', e);
        }
      })();
    </script>
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content="Luna y Brillo, Modo Pareja, ciclo menstrual, cronograma capilar, skincare, google fit, reportes medicos pdf, widget android, flutter, apk download, autocuidado" />
    <meta name="author" content="Luna y Brillo Team" />

    <!-- Open Graph / WhatsApp Preview Tags -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://luna-y-brillo.web.app/" />
    <meta property="og:title" content="Luna & Brillo 💕 — Cuidado Personal & Modo Pareja" />
    <meta property="og:description" content="Mira cómo se siente tu pareja hoy, en qué fase de su ciclo está y cómo cuidarla con amor." />
    <meta property="og:image" content="/logo.png" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content="https://luna-y-brillo.web.app/" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content="/logo.png" />

    <!-- Google Fonts Preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body class="bg-brand-cream text-[#2D141E] min-h-screen flex flex-col antialiased relative selection:bg-brand-rose selection:text-white">
    
    <!-- Floating Ambient Light Orbs with Brand Colors -->
    <div class="fixed inset-0 pointer-events-none overflow-hidden -z-10">
      <!-- Orb 1: Rosa suave superior derecho -->
      <div class="glow-orb orb-primary w-[320px] sm:w-[460px] h-[320px] sm:h-[460px] -top-20 -right-24"></div>
      
      <!-- Orb 2: Borgoña profundo inferior izquierdo -->
      <div class="glow-orb orb-burgundy w-[380px] sm:w-[520px] h-[380px] sm:h-[520px] bottom-10 -left-28" style="animation-duration: 18s;"></div>
      
      <!-- Orb 3: Acento cálido dorado central -->
      <div class="glow-orb orb-gold w-[260px] sm:w-[360px] h-[260px] sm:h-[360px] top-[40%] right-[15%]" style="animation-duration: 22s; opacity: 0.35;"></div>
    </div>

    <!-- Main Content Slot -->
    <slot />

  </body>
</html>
